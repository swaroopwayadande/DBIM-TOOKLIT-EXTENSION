{
    "manifest_version": 3,
    "name": "GIGW Toolkit - Gov Website Checker",
    "version": "1.0",
    "description": "Checks websites for compliance with Guidelines for Indian Government Websites (GIGW) 3.0.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "src/popup.html",
        "default_icon": {
            "128": "icons/icon.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content.js"
            ]
        }
    ],
    "icons": {
        "128": "icons/icon.png"
    }
}